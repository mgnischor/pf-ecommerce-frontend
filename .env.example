# Copy to .env for local development. Never commit .env (see ai/SECURITY.md).
# Development calls go through proxy.conf.json (same-origin /api, no CORS).
# Match the proxy target with the backend Compose API_PORT (default 8080).

# Backend API base URL for direct (non-proxy) setups, e.g. `dotnet run` (http://localhost:5223/api/v1).
PF_API_BASE_URL=http://localhost:5223/api/v1

# Default locale for formatting and Accept-Language (pt-BR, en).
PF_DEFAULT_LOCALE=en

# Default currency for money formatting (ISO 4217).
PF_DEFAULT_CURRENCY=BRL
